rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function invited() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && firestore.exists(/databases/(default)/documents/invites/$(request.auth.token.email.lower()));
    }

    match /users/{uid}/plans/{planId}/plan.pdf {
      allow read, delete: if invited() && request.auth.uid == uid;
      // A plot plan is a PDF, or (#20) a JPG/PNG rendered as a flat image layer.
      allow write: if invited() && request.auth.uid == uid
        && request.resource.contentType in ['application/pdf', 'image/jpeg', 'image/png']
        && request.resource.size <= 25 * 1024 * 1024;
    }
  }
}
